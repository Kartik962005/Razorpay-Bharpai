# Razorpay TEST-MODE keys (Dashboard -> Account & Settings -> API Keys). Never commit real keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set when you create a webhook in the Razorpay dashboard (Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Any OpenAI-compatible endpoint. Leave LLM_API_KEY blank to run fully on rules + templates —
# the batch, the tests and the live demo all work with no model at all.
#
# Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b   LLM_MODEL_FAST=openai/gpt-oss-20b
#
# Google AI Studio (OpenAI-compatible endpoint). Note the -lite models: at the time of writing
# the full flash models on this endpoint return malformed JSON, and several older ids are still
# listed by /models but answer 404. Check with `bharpai live doctor` before trusting one.
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.5-flash-lite LLM_MODEL_FAST=gemini-3.5-flash-lite
#   LLM_MIN_INTERVAL=4.2            # 15 requests/minute tier
#
# LLM_MAX_CALLS is this system's own ceiling. The adapter separately reads the provider's
# reported allowance and stops rather than spending calls on refusals.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MAX_CALLS=600
# Seconds between calls. Only needed for providers that report no rate-limit headers; where they
# do, the adapter paces itself from what they report.
LLM_MIN_INTERVAL=1.0

# sim | live
BHARPAI_MODE=sim
TZ=Asia/Kolkata
